# Copy to .env. Single source of truth: read by docker compose, the Prisma CLI and the API.

# --- Postgres (compose.dev.yaml) ---
POSTGRES_USER=fitmybike
POSTGRES_PASSWORD=fitmybike
POSTGRES_DB=fitmybike
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fitmybike:fitmybike@localhost:5432/fitmybike?schema=public
# Used only by the integration test suite; dropped and recreated on every run.
TEST_DATABASE_URL=postgresql://fitmybike:fitmybike@localhost:5432/fitmybike_test?schema=public

# Only needed if an AI agent runs the test suite: Prisma 7 refuses destructive
# commands (the test DB reset) from an agent without recorded human consent.
# Humans running `pnpm test` do not need this. Set it to your own words of consent.
# PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION=

# Session cookie
SESSION_COOKIE_NAME=fmb_session
SESSION_TTL_DAYS=30

# Absolute base URL of the app. Never derive this from the Host header — see the
# "same-origin by construction" note in README.md.
APP_URL=http://localhost:5173
